-- Dynamic Image Apply Helper
local function setBackgroundImage(imageId)
    if imageId == "" or not imageId then
        bgImage.Image = ""
        bgImage.Visible = false
    else
        bgImage.Visible = true
        if tonumber(imageId) then
            bgImage.Image = "rbxassetid://" .. imageId
        elseif imageId:find("rbxassetid://") or imageId:find("http") then
            bgImage.Image = imageId
        else
            bgImage.Image = "rbxassetid://" .. imageId
        end
    end
end

-- Tema Kartı Oluşturucu
local function createThemeCard(title, desc, themeData)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, -10, 0, 52)
    card.BackgroundColor3 = Color3.fromHex("070805")
    card.BackgroundTransparency = 0.5
    card.ZIndex = 6
    card.Parent = pageThemes
    
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.65, 0, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = title .. "\n<font size='10' color='#aaaaaa'>" .. desc .. "</font>"
    label.TextColor3 = Color3.fromHex("ffffff")
    label.TextSize = 12
    label.RichText = true
    label.Font = Enum.Font.Code
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = card
    
    local applyBtn = Instance.new("TextButton")
    applyBtn.Size = UDim2.new(0, 100, 0, 28)
    applyBtn.Position = UDim2.new(1, -110, 0.5, -14)
    applyBtn.BackgroundColor3 = Color3.fromHex("242599")
    applyBtn.Text = "Yükle & Uygula"
    applyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    applyBtn.TextSize = 11
    applyBtn.Font = Enum.Font.Code
    applyBtn.Parent = card
    
    Instance.new("UICorner", applyBtn).CornerRadius = UDim.new(0, 6)
    
    applyBtn.MouseButton1Click:Connect(function()
        applyBtn.Text = "Yükleniyor..."
        task.wait(0.1)
        
        setBackgroundImage(themeData.Img)
        mainFrame.BackgroundColor3 = Color3.fromHex(themeData.Bg)
        topBar.BackgroundColor3 = Color3.fromHex(themeData.Main)
        sideMenu.BackgroundColor3 = Color3.fromHex(themeData.Main)
        titleLabel.TextColor3 = Color3.fromHex(themeData.Accent)
        
        local font = Enum.Font[themeData.Font] or Enum.Font.Code
        titleLabel.Font = font
        searchBox.Font = font
        label.Font = font
        for _, btn in pairs(tabButtons) do btn.Font = font end
        
        applyBtn.Text = "Aktif!"
        applyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        task.wait(1)
        applyBtn.Text = "Yükle & Uygula"
        applyBtn.BackgroundColor3 = Color3.fromHex("242599")
    end)
end

