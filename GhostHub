-- Sekme ve Sayfa Yönetim Sistemi (Sorunsuz Çalışması İçin Düzeltildi)
local pages = {}
local tabButtons = {}
local activePageName = nil

local function createPage(pageName)
    local page = Instance.new("ScrollingFrame")
    page.Name = pageName
    page.Size = UDim2.new(1, 0, 1, 0)
    page.Position = UDim2.new(0, 0, 0, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 2
    page.CanvasSize = UDim2.new(0, 0, 0, 600)
    page.ZIndex = 5
    page.Parent = contentArea
    
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 6)
    layout.Parent = page
    
    pages[pageName] = page
    return page
end

local function switchTab(targetName)
    for name, page in pairs(pages) do
        page.Visible = (name == targetName)
    end
    for name, btn in pairs(tabButtons) do
        if name == targetName then
            btn.BackgroundColor3 = Color3.fromHex("242599") -- Aktif Buton Vurgu Rengi
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(20, 25, 35)
            btn.TextColor3 = Color3.fromRGB(180, 190, 210)
        end
    end
    activePageName = targetName
end

local function createTabButton(name, icon, targetPageName)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -12, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(20, 25, 35)
    btn.Text = "  " .. icon .. "  " .. name
    btn.TextColor3 = Color3.fromRGB(180, 190, 210)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamMedium
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.ZIndex = 6
    btn.Parent = sideMenu
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    tabButtons[targetPageName] = btn
    
    btn.MouseButton1Click:Connect(function()
        switchTab(targetPageName)
    end)
    
    return btn
end

