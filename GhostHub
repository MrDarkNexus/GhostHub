local OrbitConn = nil

addToggle(pageStairWell, "Orbit Dropped Item", "Çöpleri ve eşyaları etrafınızda dönen halkaya dönüştürür.", function(state)
    OrbitEnabled = state
    if OrbitEnabled then
        local angle = 0
        OrbitConn = RunService.Heartbeat:Connect(function(dt)
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart
            angle = angle + dt * OrbitSpeed

            local trashList = {}
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj.Name:lower():find("trash") or obj.Name:lower():find("garbage") then
                    if obj:IsA("BasePart") or (obj:IsA("Model") and obj.PrimaryPart) then
                        table.insert(trashList, obj)
                    end
                end
            end

            for i, item in ipairs(trashList) do
                local currentAngle = angle + ((i / #trashList) * math.pi * 2)
                local offset = Vector3.new(math.cos(currentAngle) * OrbitDistance, OrbitHeight, math.sin(currentAngle) * OrbitDistance)
                local targetPos = hrp.Position + offset
                if item:IsA("Model") then item:SetPrimaryPartCFrame(CFrame.new(targetPos))
                elseif item:IsA("BasePart") then item.CFrame = CFrame.new(targetPos) end
            end
        end)
    else
        if OrbitConn then OrbitConn:Disconnect() OrbitConn = nil end
    end
end)

