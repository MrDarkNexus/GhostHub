addSectionHeader(pageOutdoors, "Visuals & ESP")

local PathBeams = {}
local function ClearPathESP()
    for _, beam in ipairs(PathBeams) do
        pcall(function() beam:Destroy() end)
    end
    PathBeams = {}
end

addToggle(pageOutdoors, "Eyestalk Path ESP", "Eyestalk patikasının sonuna kadar giden yeşil çizgi ESP'si.", function(state)
    if state then
        ClearPathESP()
        local pathFolder = Workspace:FindFirstChild("EyestalkPath") or Workspace:FindFirstChild("Path")
        if pathFolder then
            local waypoints = {}
            for _, pt in ipairs(pathFolder:GetChildren()) do
                if pt:IsA("BasePart") then table.insert(waypoints, pt) end
            end

            -- Noktaları sırayla yeşil Beam çizgisi ile birleştir
            for i = 1, #waypoints - 1 do
                local p1, p2 = waypoints[i], waypoints[i + 1]
                
                local att0 = Instance.new("Attachment", p1)
                local att1 = Instance.new("Attachment", p2)
                
                local beam = Instance.new("Beam")
                beam.Attachment0 = att0
                beam.Attachment1 = att1
                beam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 100)) -- Yeşil
                beam.Width0 = 0.25 -- Az kalın çizgi
                beam.Width1 = 0.25
                beam.FaceCamera = true
                beam.Parent = p1
                
                table.insert(PathBeams, beam)
                table.insert(PathBeams, att0)
                table.insert(PathBeams, att1)
            end
        end
    else
        ClearPathESP()
    end
end)

