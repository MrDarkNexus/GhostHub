local AntiVacuumConn = nil
addToggle(pageBackDoors, "Anti-Vacuum", "Vacuum mekanizmasının sizi içine çekmesini engeller.", function(state)
    if state then
        AntiVacuumConn = RunService.Heartbeat:Connect(function()
            local char = player.Character
            if not char then return end
            
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- Vacuum'un uyguladığı dış kuvvetleri (BodyVelocity, VectorForce vb.) temizle
                for _, child in ipairs(hrp:GetChildren()) do
                    if child:IsA("BodyVelocity") or child:IsA("BodyForce") or child:IsA("VectorForce") or child:IsA("LinearVelocity") then
                        if child.Name:lower():find("vacuum") or child.Name:lower():find("pull") or child.Name:lower():find("suck") then
                            child:Destroy()
                        end
                    end
                end
            end

            -- Haritadaki Vacuum nesnelerinin çekim alanlarını devre dışı bırak
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj.Name:lower():find("vacuum") or obj.Name:lower():find("suckzone") then
                    if obj:IsA("BasePart") then
                        obj.CanTouch = false
                    elseif obj:IsA("Model") then
                        for _, p in ipairs(obj:GetDescendants()) do
                            if p:IsA("BasePart") then p.CanTouch = false end
                        end
                    end
                end
            end
        end)
    else
        if AntiVacuumConn then AntiVacuumConn:Disconnect() AntiVacuumConn = nil end
    end
end)

