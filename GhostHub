local function createThemeCard(title, desc, themeData)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, -10, 0, 50)
    card.BackgroundColor3 = Color3.fromHex("070805")
    card.BackgroundTransparency = 0.5
    card.ZIndex = 6
    card.Parent = pageThemes
    
    local cCorner = Instance.new("UICorner")
    cCorner.CornerRadius = UDim.new(0, 8)
    cCorner.Parent = card
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.65, 0, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = title .. "\n<font size='10' color='#aaaaaa'>" .. desc .. "</font>"
    label.TextColor3 = Color3.fromHex("ffffff")
    label.TextSize = 12
    label.RichText = true
    label.Font = Enum.Font.Code
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = card
    
    local applyBtn = Instance.new("TextButton")
    applyBtn.Size = UDim2.new(0, 90, 0, 26)
    applyBtn.Position = UDim2.new(1, -100, 0.5, -13)
    applyBtn.BackgroundColor3 = Color3.fromHex("242599")
    applyBtn.Text = "Uygula"
    applyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    applyBtn.TextSize = 11
    applyBtn.Font = Enum.Font.Code
    applyBtn.Parent = card
    
    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 6)
    bCorner.Parent = applyBtn
    
    applyBtn.MouseButton1Click:Connect(function()
        bgImage.Image = "rbxassetid://" .. themeData.BackgroundImage
        mainFrame.BackgroundColor3 = Color3.fromHex(themeData.BackgroundColor)
        topBar.BackgroundColor3 = Color3.fromHex(themeData.MainColor)
        sideMenu.BackgroundColor3 = Color3.fromHex(themeData.MainColor)
        titleLabel.TextColor3 = Color3.fromHex(themeData.AccentColor)
        
        local selectedFont = Enum.Font[themeData.FontFace] or Enum.Font.Code
        titleLabel.Font = selectedFont
        searchBox.Font = selectedFont
        
        applyBtn.Text = "Aktif!"
        task.wait(1)
        applyBtn.Text = "Uygula"
    end)
end

