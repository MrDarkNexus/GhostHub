local HasteClockGui, HasteClockLabel = nil, nil
addToggle(pageBackDoors, "Haste Clock Time", "Haste zamanını ve kalan süreyi ekranda beyaz renkte gösterir.", function(state)
    if state then
        HasteClockGui = Instance.new("ScreenGui")
        HasteClockGui.Name = "GhostHub_HasteClock"
        HasteClockGui.Parent = (gethui and gethui()) or CoreGui or playerGui

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, 180, 0, 36)
        frame.Position = UDim2.new(0.5, -90, 0.15, 0)
        frame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
        frame.Active = true
        frame.Draggable = true
        frame.Parent = HasteClockGui
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

        HasteClockLabel = Instance.new("TextLabel")
        HasteClockLabel.Size = UDim2.new(1, 0, 1, 0)
        HasteClockLabel.BackgroundTransparency = 1
        HasteClockLabel.Text = "Haste Time: 00:00"
        HasteClockLabel.TextColor3 = Color3.fromRGB(255, 255, 255) -- Beyaz renk
        HasteClockLabel.Font = Enum.Font.Code
        HasteClockLabel.TextSize = 12
        HasteClockLabel.Parent = frame

        local hasteStart = tick()
        task.spawn(function()
            while HasteClockGui do
                local elapsed = math.floor(tick() - hasteStart)
                local mins = math.floor(elapsed / 60)
                local secs = elapsed % 60
                if HasteClockLabel then
                    HasteClockLabel.Text = string.format("Haste Time: %02d:%02d", mins, secs)
                end
                task.wait(1)
            end
        end)
    else
        if HasteClockGui then HasteClockGui:Destroy() HasteClockGui = nil end
    end
end)

