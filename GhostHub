-- Çift Sütunlu Sayfa Düzeni Fonksiyonu (Abysall Hub Tarzı)
local function createTwoColumnPage(pageName)
    local page = Instance.new("Frame")
    page.Name = pageName
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ZIndex = 3
    page.Parent = contentArea

    -- Sol Sütun
    local leftCol = Instance.new("ScrollingFrame")
    leftCol.Size = UDim2.new(0.48, 0, 1, 0)
    leftCol.Position = UDim2.new(0, 0, 0, 0)
    leftCol.BackgroundTransparency = 1
    leftCol.ScrollBarThickness = 2
    leftCol.CanvasSize = UDim2.new(0, 0, 0, 600)
    leftCol.ZIndex = 3
    leftCol.Parent = page

    -- Sağ Sütun
    local rightCol = Instance.new("ScrollingFrame")
    rightCol.Size = UDim2.new(0.48, 0, 1, 0)
    rightCol.Position = UDim2.new(0.52, 0, 0, 0)
    rightCol.BackgroundTransparency = 1
    rightCol.ScrollBarThickness = 2
    rightCol.CanvasSize = UDim2.new(0, 0, 0, 600)
    rightCol.ZIndex = 3
    rightCol.Parent = page

    return page, leftCol, rightCol
end

