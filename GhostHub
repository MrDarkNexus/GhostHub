-- 🔧 GÜVENLİ RESİM YÜKLEME MOTORU
local function applyImageTarget(rawId)
    if not rawId or rawId == "" or rawId == "none" then
        bgImage.Image = ""
        return
    end
    
    local cleanId = tostring(rawId):match("%d+")
    if cleanId then
        local formattedUrl = "rbxassetid://" .. cleanId
        bgImage.Image = formattedUrl
        task.spawn(function()
            pcall(function()
                ContentProvider:PreloadAsync({bgImage})
            end)
        end)
    else
        bgImage.Image = rawId
    end
end

