local function applyTheme(tName)
    local tData = themes[tName]
    if tData then
        activeTheme = tData
        mainFrame.BackgroundColor3 = tData.MainBg
        topBar.BackgroundColor3 = tData.TopBar
        sideMenu.BackgroundColor3 = tData.SideMenu
        titleLabel.TextColor3 = tData.Accent
    end
end

