local function createPage(pageName)
    local page = Instance.new("ScrollingFrame")
    page.Name = pageName
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 3
    page.CanvasSize = UDim2.new(0, 0, 0, 5200)
    page.ZIndex = 5
    page.Parent = contentArea
    
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.Parent = page
    
    pages[pageName] = page
    return page
end

local function switchTab(targetName)
    for name, page in pairs(pages) do
        page.Visible = (name == targetName)
    end
    for name, btn in pairs(tabButtons) do
        if name == targetName then
            btn.BackgroundColor3 = Color3.fromHex("242599")
            btn.BackgroundTransparency = 0.2
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromHex("070805")
            btn.BackgroundTransparency = 0.6
            btn.TextColor3 = Color3.fromRGB(180, 190, 210)
        end
    end
end

